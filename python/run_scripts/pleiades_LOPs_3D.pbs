#PBS -S /bin/bash
#PBS -N LOPs_3D
#PBS -l select=8:ncpus=128:mpiprocs=128:model=rom_ait
#PBS -l walltime=8:00:00
#PBS -j oe
#PBS -q normal
#PBS -W group_list=s2328

export dedalus_script=scan_linear_optimals_3d
export cfg_file=kx-log-ky-lin_MA0.5_Re250_kxmin1e-3_T3tA_Nz512-k600-saveLOPsAndEvolved_highcadence

cd $PBS_O_WORKDIR

source ~/miniforge3/bin/activate
conda activate dedalus-d2

date
mpiexec_mpt -n 1024 python3 $dedalus_script.py LOPs_3D/config_files/run_$cfg_file.cfg > $dedalus_script.$cfg_file.out.$PBS_JOBID
date
